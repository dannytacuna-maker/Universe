# Clerk provisions the first two values. Only Daniel's allowlisted Google email
# can access synchronized records.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MISSION_CONTROL_OWNER_EMAIL=
DATABASE_URL=

# Optional for text locally; required for Jarvis Realtime voice in production.
# Text generation on Vercel can otherwise authenticate AI Gateway with OIDC.
AI_GATEWAY_API_KEY=

# Optional ElevenLabs voice for Jarvis replies. Without this key, browser TTS is used.
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Optional overrides:
# ELEVENLABS_VOICE_ID=lUTamkMw7gOzZbFIwmq4
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Server-only bearer secret used by Vercel to invoke the daily Observatory job.
CRON_SECRET=

# Clerk provisions the first two values. Only Daniel's allowlisted Google email
# can access synchronized records.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MISSION_CONTROL_OWNER_EMAIL=

# Clerk Google OAuth. Allowlist owner email for sync.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MISSION_CONTROL_OWNER_EMAIL=
DATABASE_URL=

# Optional. Prefer pasting the secret iCal URL once on Home (stored in Neon).
# Google Calendar → Settings → your calendar → Integrate calendar → Secret address.
# MISSION_CONTROL_CALENDAR_ICS_URL=

# Optional for text locally; required for AI Gateway on Vercel without OIDC.
AI_GATEWAY_API_KEY=

# Server-only bearer secret used by Vercel to invoke the daily Observatory job.
CRON_SECRET=

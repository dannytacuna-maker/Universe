# Clerk Google OAuth. Allowlist owner email for sync.
# Home schedule requires production Google custom credentials in Clerk, plus:
# 1) Google Calendar API enabled in the same Google Cloud project
# 2) Scope https://www.googleapis.com/auth/calendar.readonly on the Clerk Google connection
# First Home visit redirects to Google once to grant calendar access.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MISSION_CONTROL_OWNER_EMAIL=
DATABASE_URL=

# Optional for text locally; required for AI Gateway on Vercel without OIDC.
AI_GATEWAY_API_KEY=

# Server-only bearer secret used by Vercel to invoke the daily Observatory job.
CRON_SECRET=

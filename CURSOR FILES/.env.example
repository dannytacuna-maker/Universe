# Clerk Google OAuth. Allowlist owner email for sync.
# Home schedule: enable Google Calendar API in Google Cloud, add scope
# https://www.googleapis.com/auth/calendar.events.readonly on the Clerk Google
# social connection (custom credentials). First visit auto-reconnects once.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MISSION_CONTROL_OWNER_EMAIL=
DATABASE_URL=

# Optional for text locally; required for AI Gateway on Vercel without OIDC.
AI_GATEWAY_API_KEY=

# Server-only bearer secret used by Vercel to invoke the daily Observatory job.
CRON_SECRET=
